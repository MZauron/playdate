# Names only. Copy to .env.local and fill in. Never commit real values.
# Local development: run `npm run db:start`, then take the first three from `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY).

# Browser-visible (the only ones that may be):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only:
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes for the HMAC of phone numbers: `openssl rand -hex 32`. Changing it breaks contact matching.
PHONE_HASH_KEY=

# Where invite links point (no trailing slash), e.g. http://localhost:3200 locally, the Railway URL on staging (Q16).
PUBLIC_LINK_BASE=
# Message suggestions: fake (built-in, the default) or live (Anthropic; needs the key below).
AI_MODE=fake
ANTHROPIC_API_KEY=

# Optional password curtain for staging and demos (8+ characters). Empty = no curtain. The invite page is never behind it.
SITE_PASSWORD=

# Development only: the laptop's Wi-Fi address, to open `npm run dev` from a phone (comma-separated). Leave empty otherwise.
DEV_ORIGINS=

# The cron service calls POST /api/cron/tick with "Authorization: Bearer <this>" (32+ characters: `openssl rand -hex 32`).
CRON_SECRET=

# Find a place: fake (a built-in list of Toronto places, the default) or live (Google Places (New), Q6; needs the key below).
PLACES_MODE=fake
PLACES_API_KEY=

# Later tasks add: VAPID keys.
